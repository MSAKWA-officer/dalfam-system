# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dalfam_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Frontend URL(s) for CORS — comma-separated if you use more than one (dev + preview, staging, etc.)
CLIENT_URL=http://localhost:5173,http://localhost:4173
